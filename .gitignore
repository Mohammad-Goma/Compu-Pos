## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio 2015/2017 cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Sensitive files (keep local only)
# Note: appsettings.json contains database credentials
# Consider using appsettings.Development.json for local overrides
*.local.json

# Postman sensitive files (if you want to keep them local)
# Uncomment these if you don't want to share credentials:
# *.postman_environment.json
# *.postman_collection.json

# Rider
.idea/

# VS Code
.vscode/

# Temporary files
*.tmp
*.temp
*.cache
